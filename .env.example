# ClickHouse Cloud Credentials for gapless-network-data
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

CLICKHOUSE_HOST_READONLY=your-host.clickhouse.cloud
CLICKHOUSE_USER_READONLY=default
CLICKHOUSE_PASSWORD_READONLY=your-password-here

# Healthchecks.io heartbeat ping URL for the collector / updater.
# The UUID in this URL is an unauthenticated write capability - treat it as a
# secret and never commit a real one. Pings are skipped when this is unset.
HEALTHCHECK_URL=https://hc-ping.com/your-check-uuid-here

# Pushover alert delivery (values live in Doppler: claude-config/dev)
PUSHOVER_TOKEN=your-pushover-app-token-here
PUSHOVER_USER=your-pushover-user-key-here

# Healthchecks.io management API key (values live in Doppler)
HEALTHCHECKS_API_KEY=your-healthchecks-api-key-here

# UptimeRobot API key (values live in Doppler)
UPTIMEROBOT_API_KEY=your-uptimerobot-api-key-here
